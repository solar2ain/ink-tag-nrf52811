# A .gitignore for Keil projects.
# Taken mostly from http://www.keil.com/support/man/docs/uv4/uv4_b_filetypes.htm

# User-specific uVision files
*.opt
*.uvopt
*.uvoptx
*.uvgui
*.uvgui.*
*.uvguix.*

# Listing files
*.cod
*.htm
*.i
*.lst
*.map
*.m51
*.m66
# define exception below if needed
*.scr

# Object and HEX files
*.axf
*.b[0-3][0-9]
*.hex
*.d
*.crf
*.elf
*.hex
*.h86
*.lib
*.obj
*.o
*.sbr
*.exe

# Build files
# define exception below if needed
*.bat
*._ia
*.__i
*._ii

# Publishable/generated firmware output files. This directory is never tracked;
# release export copies an explicit allowlist from it.
_build/

# Local compiler intermediates and bench/test/research captures.
.cache/
.local/
webui/public/free-layouts-generated/

# Debugger files
# define exception below if needed
*.ini

# Other files
*.build_log.htm
*.cdb
*.dep
*.ic
*.lin
*.lnp
*.orc
# define exception below if needed
*.pack
# define exception below if needed
*.pdsc
*.plg
# define exception below if needed
*.sct
*.sfd
*.sfr

# Miscellaneous
.DS_Store
._*
__pycache__/
*.pyc
*.tra
*.bin
# Fixed RAM helper shipped with the native GUI-resource programmer.
!firmware/ports/nordic/nrf52811/tools/assets/full-writer.bin
*.fed
*.l1p
*.l2p
*.iex

# Vscode config files
.vscode/

# To explicitly override the above, define any exceptions here; e.g.:
# !my_customized_scatter_file.sct

RTE_Components.h
EventRecorderStub.scvd
JLinkLog.txt
log_fw_encrypt_sign/
log_product_info/
.sdk/
work/
.vendor/
.tools/
.toolchains/
.venv/
.secrets/
node_modules/
webui/dist/

# Legacy local hardware-capture locations (kept ignored so an old script/run
# can never add them accidentally). New captures belong under .local/.
backups/firmware/
backups/tools/
/tmp/
/_tmp/
/$jflog
/Balboa.jlink

# Hardware backups remain local in this independent source repository.
/backups/

# Datasheets are reproducible downloads, not repository payload.
docs/datasheets/downloads/

# Local agent instructions never belong in remote source trees.
AGENTS.md

# Development reports stay local and are synchronized before releases.
docs/releases/
firmware/ports/nordic/nrf52811/reports/
firmware/ports/nordic/nrf52811/evidence/
firmware/ports/nordic/nrf52811/BUILD-REPORT.md
firmware/ports/nordic/nrf52811/FREE-PARITY.md

# Internal import and backport histories stay in local development archives.
/common-snapshot.json
/source-provenance.json

# Local validation output.
/.validation/

# Local caches and physical device backups.
cache/
Cache/
factory_backup/
factory_backups/
